meta {
  name: Razorpay Webhook - No Signature
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/razorpayWebhook
  body: json
  auth: none
}

body:json {
  {"event": "payment_link.paid"}
}

assert {
  res.status: eq 400
}

docs {
  Without `X-Razorpay-Signature` nothing is parsed: the signature is checked first, because this endpoint decides whether an order counts as paid.
}
