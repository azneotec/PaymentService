meta {
  name: Stripe Webhook - Checkout Completed
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/stripeWebhook
  body: json
  auth: none
}

body:json {
  {}
}

script:pre-request {
  // Stripe signs "<timestamp>.<raw body>" with the endpoint secret, so the body is built here and sent as exactly
  // the string that is signed.
  const CryptoJS = require("crypto-js");
  const now = Date.now();
  const payload = JSON.stringify({
    id: `evt_bruno_${now}`,
    object: "event",
    type: "checkout.session.completed",
    data: {
      object: {
        id: `cs_test_bruno_${now}`,
        object: "checkout.session",
        payment_status: "paid",
        payment_intent: `pi_bruno_${now}`,
        metadata: { orderId: bru.getVar("orderNumber") }
      }
    }
  });
  const t = Math.floor(now / 1000);
  const v1 = CryptoJS.HmacSHA256(`${t}.${payload}`, bru.getEnvVar("stripeWebhookSecret")).toString(CryptoJS.enc.Hex);
  req.setHeader("Content-Type", "application/json");
  req.setHeader("Stripe-Signature", `t=${t},v1=${v1}`);
  req.setBody(payload);
}

assert {
  res.status: eq 200
}

docs {
  Plays what Stripe sends when the customer has paid: the order turns PAID, `payment-result` gets a PAID message
  and the receipt email is queued. Needs `stripeWebhookSecret` to equal the service's STRIPE_WEBHOOK_SECRET.
}
