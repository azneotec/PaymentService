meta {
  name: Stripe Webhook - Ignored Event
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/stripeWebhook
  body: json
  auth: none
}

body:json {
  {}
}

script:pre-request {
  const CryptoJS = require("crypto-js");
  const now = Date.now();
  const payload = JSON.stringify({ id: `evt_bruno_${now}`, object: "event", type: "customer.created", data: { object: {} } });
  const t = Math.floor(now / 1000);
  const v1 = CryptoJS.HmacSHA256(`${t}.${payload}`, bru.getEnvVar("stripeWebhookSecret")).toString(CryptoJS.enc.Hex);
  req.setHeader("Content-Type", "application/json");
  req.setHeader("Stripe-Signature", `t=${t},v1=${v1}`);
  req.setBody(payload);
}

assert {
  res.status: eq 200
}

docs {
  A validly signed event the service does not act on is answered 200 (so Stripe stops retrying) and publishes nothing.
}
