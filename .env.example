# Copy to .env (gitignored) and adjust. Read by `./mvnw spring-boot:run`, `make run` and `java -jar`.
# Unquoted values only. Anything also set as a real environment variable takes precedence.

# Stripe is the default gateway (test-mode keys from the Stripe Dashboard work for development).
STRIPE_API_KEY=your_stripe_api_key
# Signs Stripe's webhooks (Dashboard > Developers > Webhooks); empty rejects every Stripe webhook.
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
# Optional: where the customer lands after paying; Stripe's own page when empty.
#STRIPE_REDIRECT_URL=

# Razorpay is optional: only when @Primary is moved to RazorpayPaymentGateway.
#RAZORPAY_KEY_ID=your_razorpay_key_id
#RAZORPAY_KEY_SECRET=your_razorpay_key_secret
#RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
#RAZORPAY_CALLBACK_URL=

# MySQL transaction log from `make infra-up` (or the root stack's `make infra-up`, which uses the same port).
# Use jdbc:mysql://localhost:3306/payment_service?createDatabaseIfNotExist=true for a host MySQL.
DB_URL=jdbc:mysql://localhost:3307/payment_service?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=password

# Callers are authenticated against user-auth-service, found through Eureka, so a run that serves authenticated
# requests needs Eureka (http://localhost:8761) and EUREKA_CLIENT_ENABLED=true. With the client off (a standalone
# run) every token check answers 503; webhooks and the Kafka flow do not need it.
EUREKA_CLIENT_ENABLED=true

# Optional. The app listens on 8005 by default; set 9005 to run a second instance beside it.
#SERVER_PORT=9005
